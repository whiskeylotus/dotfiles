#!/bin/sh
# Print the git state of a directory for the tmux status bar. Silent outside a repo.
# usage: tmux-git-status <path>

dir="${1:-$PWD}"
cd "$dir" 2>/dev/null || exit 0
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) ||
  branch=$(git rev-parse --short HEAD 2>/dev/null) || exit 0

dirty=$(git status --porcelain --untracked-files=no 2>/dev/null | wc -l | tr -d ' ')
[ "$dirty" -gt 0 ] 2>/dev/null && dirty=" ✚${dirty}" || dirty=""

# mark linked worktrees — easy to forget which checkout you are editing
case "$(git rev-parse --absolute-git-dir 2>/dev/null)" in
  */worktrees/*) wt="⑂ " ;;
  *)             wt="" ;;
esac

printf ' %s%s%s' "$wt" "$branch" "$dirty"
