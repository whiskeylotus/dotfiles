#!/bin/sh
# Launch GitHub's MCP server using the token `gh` already holds — no PAT to
# create, rotate, or leak into a config file. Requires `gh auth login`.
#
# Registered with:
#   claude mcp add --scope user github -- ~/dotfiles/bin/github-mcp

PATH="/opt/homebrew/bin:/usr/bin:/bin:$PATH"
export PATH

token=$(gh auth token 2>/dev/null)
if [ -z "$token" ]; then
  echo "github-mcp: not authenticated — run: gh auth login" >&2
  exit 1
fi

GITHUB_PERSONAL_ACCESS_TOKEN="$token"
export GITHUB_PERSONAL_ACCESS_TOKEN

exec github-mcp-server stdio "$@"
